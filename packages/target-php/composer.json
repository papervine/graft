{
  "name": "besdk/target-php",
  "description": "The PHP target: IR JSON on stdin, a file manifest on stdout.",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.4",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "autoload": {
    "psr-4": { "Besdk\\Target\\Php\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Besdk\\Target\\Php\\Tests\\": "tests/" }
  },
  "bin": ["bin/besdk-target-php"],
  "config": { "sort-packages": true }
}
