<Project>
  <!--
    Shared build settings for the runtime and its tests.

    `Nullable` and `TreatWarningsAsErrors` together are what make this target's type story real: nullable
    reference types are the analogue of mypy's strict mode, and a nullability warning that is only a warning is
    documentation rather than a check (SPEC.md §3.3.11).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 is "missing XML comment for publicly visible type". Private members and test classes do not
         need one, and the runtime documents everything that matters; enabling it repo-wide would reward
         comment-shaped noise rather than explanation. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
