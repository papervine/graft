{
  "name": "graft/runtime-php",
  "description": "Hand-written runtime vendored into generated PHP SDKs.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.4",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "autoload": {
    "psr-4": { "Graft\\Runtime\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Graft\\Runtime\\Tests\\": "tests/" }
  },
  "config": { "sort-packages": true }
}
