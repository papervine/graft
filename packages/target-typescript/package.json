{
  "name": "@graft/target-typescript",
  "version": "0.0.0",
  "description": "graft TypeScript target. Reads IR JSON on stdin, writes a file manifest on stdout.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "graft-target-typescript": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@graft/protocol": "workspace:*",
    "ts-morph": "^25.0.1",
    "@graft/runtime-typescript": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
